# Copy to .env for local development and fill in your own values.
# The server loads .env automatically (Node's process.loadEnvFile).
DATABASE_URL=postgres://user:password@localhost:5432/talkz
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
# Optional TURN for voice/video behind strict NATs (Part 1 #6). Leave unset to use STUN only.
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
# Test database (npm test). Must be a SEPARATE database - tests wipe it.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/talkz_test
# Object storage (Phase 2): set all four to store uploads in an S3-compatible
# bucket (Cloudflare R2, AWS S3, MinIO). Leave unset to keep uploads in
# Postgres (the Phase 1 behaviour).
# S3_BUCKET=talkz-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# Age an unreferenced bucket object must reach before the cleanup sweep
# deletes it (ms, default 3600000). Only relevant in S3 mode.
# S3_SWEEP_MIN_AGE_MS=3600000
